# The report job's container (issue #60, docs/APPLICATION.md): renders a submitted analysis run's
# PDFs with Chromium, checks them and sends the email. Kept apart from the ingest image so that
# one stays small. One command per run, started by Airflow:
#   python -m stock_analysis.report {render,validate,email} RUN_KEY
# Secrets come from the environment only (STOCK_WRITER_DB_PASSWORD, BREVO_API_KEY, ...); Blob
# storage (STOCK_REPORTS_URL) is reached with the job's managed identity.
#   docker build -f Dockerfile.report -t stock-report .
FROM python:3.12-slim

# Arial and Courier lookalikes, as the reports' stylesheet asks for
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium-headless-shell \
        fonts-liberation fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
COPY config ./config
RUN uv sync --frozen --no-dev

# Chromium needs a home it can write to; nothing runs as root.
RUN useradd --create-home report
USER report
ENV CHROME_PATH=/usr/bin/chromium-headless-shell XDG_CACHE_HOME=/tmp/cache STOCK_DB_TARGET=server-writer
ENTRYPOINT ["/app/.venv/bin/python", "-m", "stock_analysis.report"]
