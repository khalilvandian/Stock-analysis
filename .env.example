# Copy to .env for local development. Never commit the real .env.
# In Claude Code on the web, set these in the cloud environment's settings instead.

# Optional: Financial Modeling Prep. The free plan blocks most utility tickers (HTTP 402).
FMP_API_KEY=your-key-here

# Recommended: identifies the SEC EDGAR downloader, e.g. "stock-analysis you@example.com".
SEC_USER_AGENT=stock-analysis your-contact-email
