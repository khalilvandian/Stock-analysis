# Copy to .env for local development. Never commit the real .env.
# In Claude Code on the web, set these in the cloud environment's settings instead.

# Optional: Financial Modeling Prep. The free plan blocks most utility tickers (HTTP 402).
FMP_API_KEY=your-key-here

# Recommended: identifies the SEC EDGAR downloader, e.g. "stock-analysis you@example.com".
SEC_USER_AGENT=stock-analysis your-contact-email

# Database password for the PostgreSQL targets in config/database.toml (local, server).
# For local, docker compose gives the same password to the container. Any long random value.
STOCK_DB_PASSWORD=choose-a-long-random-password

# Password of stock_admin on the Azure server (target server in config/database.toml).
STOCK_SERVER_DB_PASSWORD=the-azure-admin-password

# The working database users (python -m stock_analysis.db create-roles generates them).
STOCK_READER_DB_PASSWORD=generated
STOCK_WRITER_DB_PASSWORD=generated
# Optional: lets the Azure ingest job start the site's Pages workflow when a run ends.
# A fine-grained personal access token for this repository only, "Actions: Read and write".
# GITHUB_DISPATCH_TOKEN=github_pat_...
# Optional: the default target on this machine (e.g. server-writer in Claude's cloud environment).
# STOCK_DB_TARGET=server-writer
